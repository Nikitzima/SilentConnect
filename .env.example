# =============================================================================
# SilentConnect Multi-Service Ecosystem - Master Environment Configuration
# =============================================================================
# Copy this file to .env (or service-specific env files) and customize values.
# NEVER commit production secrets, private keys, or API tokens to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT & BRAND CONFIGURATION
# -----------------------------------------------------------------------------
# Telegram Bot API token issued by @BotFather (format: 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=123456789:dummy_token_placeholder_abcdefghij

# Public username of your Telegram Bot (without leading '@')
TELEGRAM_BOT_USERNAME=SilentConnectVPNBot

# Brand name displayed across bot messages, web UI, and email templates
BRAND_NAME=SilentConnect

# Customer support Telegram URL or deep-link
SUPPORT_TG_URL=https://t.me/example_support

# Optional banner image URLs or local paths for bot onboarding
WELCOME_MEDIA=
QUICKSTART_MEDIA=

# Comma-separated list of Telegram usernames granted administrative access
ADMIN_TG_USERNAMES=admin_user,ops_lead

# Comma-separated list of numeric Telegram User IDs granted admin privileges
ADMIN_TG_IDS=123456789,987654321

# Require valid invite token or promotional code for new user registration (true/false)
INVITE_REQUIRED=true

# Version identifier for legal agreement and terms of service acknowledgement
TERMS_VERSION=2026-04-20

# Number of days to retain inactive/expired profile records before automated purge
PURGE_AFTER_DAYS=90

# -----------------------------------------------------------------------------
# 2. PRICING, DEVICE CONCURRENCY & TARIFF TIERS
# -----------------------------------------------------------------------------
# Monthly tariff pricing in RUB based on device concurrency limits
MONTHLY_PRICE_3_DEVICES_RUB=100
MONTHLY_PRICE_6_DEVICES_RUB=150
MONTHLY_PRICE_9_DEVICES_RUB=200

# Legacy transport-specific pricing (fallback)
MONTHLY_PRICE_TCP_RUB=100
MONTHLY_PRICE_XHTTP_RUB=100

# Default simultaneous connection limit per provisioned profile
DEFAULT_DEVICE_LIMIT=3

# -----------------------------------------------------------------------------
# 3. PAYMENT GATEWAY & REQUISITES CONFIGURATION
# -----------------------------------------------------------------------------
# Instruction text displayed to users during manual payment flow
PAYMENT_INSTRUCTIONS_TEXT=Оплатите по указанным реквизитам СБП и нажмите кнопку 'Оплачено'.

# Fast Payment System (SBP) QR code URL or deep-link
PAYMENT_TRANSFER_URL=https://t.tb.ru/c2c-qr-choose-bank?requisiteNumber=+79001234567&bankCode=100000000004

# Bank name or transfer notes shown alongside payment instructions
PAYMENT_BANK_NOTE=Приоритетно переводить в Банк-Партнер (получатель: Имя Ф.)

# Bank card / account requisite placeholder
MTS_BANK_PAYMENT_DETAILS=2200 0000 0000 0000

# -----------------------------------------------------------------------------
# 4. WEB STOREFRONT & CAPTCHA SECURITY
# -----------------------------------------------------------------------------
# Local binding interface and port for the standalone web checkout server
WEB_LISTEN_HOST=127.0.0.1
WEB_LISTEN_PORT=3090

# Canonical public HTTPS base URL for the web storefront
WEB_PUBLIC_BASE_URL=https://example.com

# Cloudflare Turnstile bot protection keys (for web checkout & cabinet access)
CF_TURNSTILE_SITE_KEY=0x4AAAAAAATestKey
CF_TURNSTILE_SECRET_KEY=0x4AAAAAAATestSecret
CF_TURNSTILE_ENABLED=true

# -----------------------------------------------------------------------------
# 5. 3X-UI PANEL & XRAY CORE API INTEGRATION
# -----------------------------------------------------------------------------
# Base URL for the 3X-UI administrative web panel API
XUI_PANEL_URL=https://127.0.0.1:2053/your_secret_panel_path/

# Admin credentials for 3X-UI REST API authentication
XUI_USERNAME=admin_user
XUI_PASSWORD=change_this_strong_password

# Verify SSL certificate when connecting to local 3X-UI panel (true/false)
XUI_VERIFY_TLS=false

# Local filesystem path to the 3X-UI SQLite database
XUI_DB_PATH=/etc/x-ui/x-ui.db

# Inbound ID in 3X-UI configured for VLESS + XHTTP + TLS transport
XUI_XHTTP_INBOUND_ID=1

# Inbound ID in 3X-UI configured for VLESS + TCP + XTLS-Reality transport
XUI_TCP_INBOUND_ID=2

# -----------------------------------------------------------------------------
# 6. APPLICATION PERSISTENCE & DATABASE PATHS
# -----------------------------------------------------------------------------
# Directory storing SQLite database files, WAL logs, and runtime state
SHOP_DATA_DIR=/root/vpn-shop/data
SHOP_DB_PATH=/root/vpn-shop/data/vpn_shop.db
STORE_DB_PATH=/root/vpn-shop/data/vpn_shop.db

# -----------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL DISPATCH (SMTP / RESEND API)
# -----------------------------------------------------------------------------
# Customer support contact email address
SUPPORT_EMAIL=support@example.com

# Outgoing SMTP server hostname (or smtp.resend.com)
SMTP_HOST=smtp.example.com
SMTP_PORT=465

# SMTP authentication username (or 'resend' for Resend API)
SMTP_USER=user@example.com

# SMTP password or Resend API token (e.g., xkeysib-... or re_...)
SMTP_PASSWORD=dummy_smtp_password_placeholder

# Sender address shown in the 'From' header of transactional emails
SMTP_FROM_EMAIL=SilentConnect <support@example.com>

# -----------------------------------------------------------------------------
# 8. SUBJSON SUBSCRIPTION SERVICE & DYNAMIC GENERATORS
# -----------------------------------------------------------------------------
# Network interface and port for the SubJSON subscription engine
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3088

# Obfuscated URL path segment shielding subscription routes
SECRET_SEGMENT=my-secret-sub

# Base subscription URL provided to bot users and web customers
SUBSCRIPTION_BASE_URL=https://sub.example.com/my-secret-sub/json

# Primary server public FQDN or IP for inbound connections
PUBLIC_HOST=edge.example.com

# Public subscription origin URLs for client apps
PUBLIC_SUBSCRIPTION_ORIGIN=https://sub.example.com
FALLBACK_SUBSCRIPTION_ORIGIN=https://edge.example.com

# Optional intermediate relay server host and ports for dual-hop routing
RELAY_PUBLIC_HOST=relay.example.com
RELAY_TCP_PORT=443
RELAY_XHTTP_PORT=8443

# Rate limiting for subscription endpoints (requests per minute per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=1200

# Internal authorization token for standby quiesce locking endpoints
INTERNAL_SECRET=change_this_quiesce_secret_token

# Country flag emoji prepended to node descriptions
SERVER_COUNTRY_FLAG=🇳🇱

# -----------------------------------------------------------------------------
# 9. HAPP CLIENT METADATA & ENCRYPTED PROFILE HEADERS
# -----------------------------------------------------------------------------
# Enable custom Happ-User-Info and group headers in HTTP responses
HAPP_HEADERS_ENABLED=true
HAPP_PROFILE_TITLE=SilentConnect
HAPP_PROVIDER_ID=00000000-0000-0000-0000-000000000000
HAPP_SUPPORT_URL=https://t.me/example_support
HAPP_WEB_PAGE_URL=https://example.com
HAPP_RENEW_URL=https://t.me/SilentConnectVPNBot?start=open
HAPP_PROFILE_UPDATE_INTERVAL=1
HAPP_SERVER_DESCRIPTION=Основной сервер (NL)
HAPP_SUB_INFO_ENABLED=true
HAPP_UNLIMITED_AFTER_DAYS=3650
HAPP_RESOLVE_DNS_DOMAIN=https://dns.google/dns-query
HAPP_RESOLVE_DNS_IP=8.8.8.8
HAPP_EXTRA_EXCLUDE_ROUTES=

# -----------------------------------------------------------------------------
# 10. REALITY CRYPTOGRAPHIC KEYS & SHORT IDS
# -----------------------------------------------------------------------------
# Public keys and short IDs for Reality TLS camouflage
TCP_REALITY_PUBLIC_KEY=mock_tcp_reality_public_key_placeholder
TCP_REALITY_SHORT_ID=0123456789abcdef
GRPC_REALITY_PUBLIC_KEY=mock_grpc_reality_public_key_placeholder
GRPC_REALITY_SHORT_ID=0123456789abcdef

# Secondary (FI) standby Reality configuration
FI_XHTTP_REALITY_PUBLIC_KEY=mock_fi_reality_public_key_placeholder
FI_XHTTP_REALITY_SHORT_ID=0123456789abcdef
FI_XHTTP_REALITY_PORT=39443

# -----------------------------------------------------------------------------
# 11. HYSTERIA2 & WEBSOCKET FALLBACK CONFIGURATION
# -----------------------------------------------------------------------------
HYSTERIA_SALAMANDER_PASSWORD=change_this_salamander_password
HYSTERIA_AUTH_PASSWORD=change_this_hysteria_auth_password
WS443_PUBLIC_HOST=sub.example.com
WS443_PUBLIC_PORT=443
WS443_PATH=/sc-ws-fallback

# -----------------------------------------------------------------------------
# 12. AMNEZIAWG MULTI-NODE MESH (NL MASTER & FI STANDBY)
# -----------------------------------------------------------------------------
# Current node identifier ('nl' for Master Netherlands, 'fi' for Standby Finland)
AWG_LOCAL_SERVER=nl

# Monthly quota in Gigabytes enforced by awg_reconcile.py
AWG_MONTHLY_QUOTA_GB=500

# Path to AllowedIPs whitelist file for routing split-tunneling
AWG_ALLOWED_IPS_FILE=/root/vpn-shop/awg/allowed-ips.txt
AWG_FI_ALLOWED_IPS_FILE=/root/vpn-shop/awg/allowed-ips.txt

# DNS resolvers and MTU for client WireGuard interface
AWG_CLIENT_DNS=1.1.1.1, 1.0.0.1
AWG_CLIENT_MTU=1280

# Primary Node (NL) AmneziaWG Docker container & network parameters
AWG_NL_CONTAINER=amnezia-awg2
AWG_NL_HOST=127.0.0.1
AWG_NL_ENDPOINT_HOST=warp.example.com
AWG_NL_ENDPOINT_PORT=44121
AWG_NL_SUBNET=10.8.1
AWG_NL_SSH_USER=root
AWG_NL_SSH_PORT=22

# Secondary Node (FI) AmneziaWG Docker container & network parameters
AWG_FI_CONTAINER=amnezia-awg2
AWG_FI_HOST=198.51.100.1
AWG_FI_ENDPOINT_HOST=fi.example.com
AWG_FI_ENDPOINT_PORT=49752
AWG_FI_SUBNET=10.8.2
AWG_FI_SSH_USER=root
AWG_FI_SSH_PORT=22

# -----------------------------------------------------------------------------
# 13. DISASTER RECOVERY, CLOUDFLARE DNS & INFRASTRUCTURE
# -----------------------------------------------------------------------------
# Cloudflare API token with Zone:DNS:Edit permissions for automated failover
CF_API_TOKEN=mock_cloudflare_api_token_32chars_long
CLOUDFLARE_API_TOKEN=mock_cloudflare_api_token_32chars_long
CF_ZONE_ID=mock_cloudflare_zone_id_32chars_long
CLOUDFLARE_ZONE_ID=mock_cloudflare_zone_id_32chars_long

# Canonical domain names for DNS records and Caddy routing
DOMAIN_MAIN=example.com
DOMAIN_SUB=sub.example.com
DOMAIN_EDGE=edge.example.com
DOMAIN_FI=fi.example.com
PANEL_URL=https://127.0.0.1:2053/

# Infrastructure node IP addresses
NL_IP=192.0.2.1
NL_HOST=192.0.2.1
FI_IP=198.51.100.1
FI_HOST=198.51.100.1
FI_STANDBY_IP=198.51.100.1
