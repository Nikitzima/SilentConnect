# Optional overlay for the clean SilentConnect bot.
# Use with: python -m vpn_shop --env-file .env.silentconnect run-bot
# This file overrides values from .env but can leave shared XUI settings there.

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CHANGE_ME_BOT_USERNAME

BRAND_NAME=SilentConnect
SUPPORT_TG_URL=https://t.me/YOUR_SUPPORT_BOT
WELCOME_MEDIA=assets/telegram/welcome.png
QUICKSTART_MEDIA=assets/telegram/quickstart.png

SUBSCRIPTION_BASE_URL=https://sub.example.com/YOUR_SECRET_SEGMENT/json

# Public browsing stays open, but paid checkout still requires invite unless this is false.
INVITE_REQUIRED=true
